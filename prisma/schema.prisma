generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String                 @id @default(cuid())
  name         String
  sortOrder    Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  products     Product[]
  margenConfig ConfigMargenCategoria?

  @@index([isActive, sortOrder])
}

model Product {
  id                         String                 @id @default(cuid())
  categoryId                 String
  name                       String
  priceCents                 Int
  isActive                   Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  consumptionRecipeVersionId String?
  inventoryItemId            String?
  saleItems                  PosSaleItem[]
  category                   Category               @relation(fields: [categoryId], references: [id])
  consumptionRecipeVersion   RecipeVersion?         @relation("ProductConsumptionRecipeVersion", fields: [consumptionRecipeVersionId], references: [id])
  inventoryItem              InventoryItem?         @relation("ProductInventoryItem", fields: [inventoryItemId], references: [id])
  modifierGroups             ProductModifierGroup[]
  priceHistory               PriceHistory[]

  @@index([categoryId, isActive])
  @@index([inventoryItemId])
  @@index([consumptionRecipeVersionId])
}

model ModifierGroup {
  id        String                 @id @default(cuid())
  name      String
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  options   ModifierOption[]
  products  ProductModifierGroup[]
}

model ModifierOption {
  id              String                @id @default(cuid())
  groupId         String
  name            String
  priceDeltaCents Int                   @default(0)
  isActive        Boolean               @default(true)
  inventoryItemId String?
  inventoryQty    Decimal?              @db.Decimal(18, 3)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  group           ModifierGroup         @relation(fields: [groupId], references: [id])
  inventoryItem   InventoryItem?        @relation(fields: [inventoryItemId], references: [id])
  saleItemLinks   PosSaleItemModifier[]

  @@index([groupId, isActive])
  @@index([inventoryItemId])
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int           @default(0)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model Customer {
  id          String                   @id @default(cuid())
  displayName String
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  address      String?
  razonSocial  String?
  cuit         String?
  ivaCondition IvaCondition?

  contactName1  String?
  contactPhone1 String?
  contactEmail1 String?
  contactName2  String?
  contactPhone2 String?
  contactEmail2 String?

  accounts    CuentaCorrienteAccount[]
  sales       PosSale[]

  @@index([isActive, displayName])
}

enum IvaCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  OTRO
}

model CuentaCorrienteAccount {
  id                  String                   @id @default(cuid())
  customerId          String
  planCode            String?
  coverageAmountCents Int?
  billingCycle        BillingCycle             @default(MENSUAL)
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  customer            Customer                 @relation(fields: [customerId], references: [id])
  invoices            CuentaCorrienteInvoice[]
  payments            PosPayment[]
  sales               PosSale[]                @relation("SaleCuentaCorriente")
  directCharges       CcDirectCharge[]

  billsToAccountId  String?
  billsToAccount    CuentaCorrienteAccount?  @relation("AccountBilling", fields: [billsToAccountId], references: [id])
  satelliteAccounts CuentaCorrienteAccount[] @relation("AccountBilling")

  @@index([customerId, isActive])
  @@index([billsToAccountId])
}

model CuentaCorrienteInvoice {
  id                      String                 @id @default(cuid())
  accountId               String
  periodFrom              DateTime
  periodTo                DateTime
  billingDate             DateTime               @default(now())
  estimatedPaymentDate    DateTime
  subtotalCents           Int
  ivaExento               Boolean                @default(false)
  ivaDiscriminado         Boolean                @default(false)
  ivaAmountCents          Int                    @default(0)
  bankWithholdingCents    Int                    @default(0)
  bankFeesCents           Int                    @default(0)
  totalAmountCents        Int
  arcaFacturaNumber       String?
  ivaRetentionCents       Int                    @default(0)
  gananciasRetentionCents Int                    @default(0)
  rentasRetentionCents    Int                    @default(0)
  sussRetentionCents      Int                    @default(0)
  tisshRetentionCents     Int                    @default(0)
  isPaid                  Boolean                @default(false)
  paidAt                  DateTime?
  paidAmountCents         Int                    @default(0)
  paymentDate             DateTime?
  paymentReference        String?
  digitalInvoiceUrl       String?
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  account                 CuentaCorrienteAccount @relation(fields: [accountId], references: [id])
  sales                   PosSale[]              @relation("InvoicedSales")
  directCharges           CcDirectCharge[]
  localCashMovements      LocalCashMovement[]

  @@index([accountId, isPaid])
  @@index([estimatedPaymentDate])
}

model Employee {
  id                                 String                       @id @default(cuid())
  displayName                        String
  isActive                           Boolean                      @default(true)
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt
  role                               EmployeeRole                 @default(ASOCIADO)
  pinHash                            String?
  cashSessions                       CashSession[]
  envelopesControlled                Envelope[]                   @relation("EmployeeEnvelopesControlled")
  envelopesOpened                    Envelope[]                   @relation("EmployeeEnvelopesOpened")
  localCashMovementsCreated          LocalCashMovement[]          @relation("EmployeeLocalCashMovementsCreated")
  localExpensesCreated               LocalExpense[]               @relation("EmployeeLocalExpensesCreated")
  payments                           PosPayment[]
  stockMovementsCreated              StockMovement[]              @relation("EmployeeStockMovementsCreated")
  ccDirectChargesCreated             CcDirectCharge[]             @relation("EmployeeCcDirectChargesCreated")
  margenConfigsUpdated               ConfigMargenCategoria[]
  priceHistoryCreated                PriceHistory[]               @relation("EmployeePriceHistoryCreated")
  priceBulkUpdatesCreated            PriceBulkUpdate[]            @relation("EmployeePriceBulkUpdatesCreated")
  supplierPaymentsCreated            SupplierPayment[]            @relation("EmployeeSupplierPaymentsCreated")
  creditCardStatementPaymentsCreated CreditCardStatementPayment[] @relation("EmployeeCreditCardStatementPaymentsCreated")
  costoFijoPaymentsCreated           CostoFijoPayment[]           @relation("EmployeeCostoFijoPaymentsCreated")

  @@index([isActive, displayName])
}

model CashSession {
  id                        String                              @id @default(cuid())
  businessDate              DateTime
  shift                     Shift
  employeeId                String
  status                    CashSessionStatus                   @default(OPEN)
  openedAt                  DateTime                            @default(now())
  closedAt                  DateTime?
  openKey                   String?                             @unique
  notes                     String?
  totalCashCents            Int                                 @default(0)
  totalDebitCents           Int                                 @default(0)
  totalCreditCents          Int                                 @default(0)
  totalTransferCents        Int                                 @default(0)
  totalQrCents              Int                                 @default(0)
  totalCuentaCorrienteCents Int                                 @default(0)
  totalCuentasInternasCents Int                                 @default(0)
  totalIncomeCents          Int                                 @default(0)
  totalExpensesCents        Int                                 @default(0)
  totalNetCents             Int                                 @default(0)
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  employee                  Employee                            @relation(fields: [employeeId], references: [id])
  paymentDetails            CashSessionPaymentBreakdownDetail[]
  envelope                  Envelope?
  localExpenses             LocalExpense[]
  sales                     PosSale[]

  @@index([businessDate, shift, status])
  @@index([employeeId, businessDate, shift])
}

model CashSessionPaymentBreakdownDetail {
  id            String                       @id @default(cuid())
  cashSessionId String
  type          CashSessionPaymentDetailType
  referenceId   String?
  referenceName String
  amountCents   Int
  createdAt     DateTime                     @default(now())
  cashSession   CashSession                  @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId, type])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  categoria String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  expenses  LocalExpense[]
  purchases Purchase[]
  payables  SupplierPayable[]
  payments  SupplierPayment[]

  @@index([active, name])
}

model LocalExpense {
  id                   String                    @id @default(cuid())
  cashSessionId        String?
  date                 DateTime
  category             LocalExpenseCategory
  supplierId           String
  supplierNameSnapshot String
  description          String?
  amountCents          Int
  paymentSource        LocalExpensePaymentSource
  affectsStock         Boolean                   @default(false)
  createdByEmployeeId  String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  localCashMovements   LocalCashMovement[]
  cashSession          CashSession?              @relation(fields: [cashSessionId], references: [id])
  createdByEmployee    Employee                  @relation("EmployeeLocalExpensesCreated", fields: [createdByEmployeeId], references: [id])
  supplier             Supplier                  @relation(fields: [supplierId], references: [id])
  stockMovement        StockMovement?

  @@index([cashSessionId, date])
  @@index([supplierId, date])
  @@index([paymentSource, date])
}

model Envelope {
  id                     String              @id @default(cuid())
  envelopeCode           String              @unique
  cashSessionId          String              @unique
  expectedAmountCents    Int
  actualAmountCents      Int?
  status                 EnvelopeStatus      @default(CLOSED)
  depositedAt            DateTime            @default(now())
  openedAt               DateTime?
  controlledAt           DateTime?
  openedByEmployeeId     String?
  controlledByEmployeeId String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  cashSession            CashSession         @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  controlledByEmployee   Employee?           @relation("EmployeeEnvelopesControlled", fields: [controlledByEmployeeId], references: [id])
  openedByEmployee       Employee?           @relation("EmployeeEnvelopesOpened", fields: [openedByEmployeeId], references: [id])
  localCashMovements     LocalCashMovement[]

  @@index([status, depositedAt])
}

model LocalCashBox {
  id                      String                       @id @default(cuid())
  name                    String                       @unique
  active                  Boolean                      @default(true)
  kind                    CashBoxKind                  @default(EFECTIVO)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  movements               LocalCashMovement[]
  supplierPayments        SupplierPayment[]
  creditCardsPayingFrom   CreditCard[]
  creditCardStatementPays CreditCardStatementPayment[]
  costoFijoPayments       CostoFijoPayment[]
  paymentMethodConfigs    CashBoxPaymentMethodConfig[]

  @@index([active, name])
  @@index([kind, active])
}

model CashBoxPaymentMethodConfig {
  id                     String           @id @default(cuid())
  cashBoxId              String
  method                 PosPaymentMethod
  settlementBusinessDays Int              @default(0)
  withholdingPercent     Decimal?         @db.Decimal(5, 2)
  feesPercent            Decimal?         @db.Decimal(5, 2)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  cashBox                LocalCashBox     @relation(fields: [cashBoxId], references: [id])

  @@unique([cashBoxId, method])
}

model LocalCashMovement {
  id                                  String                      @id @default(cuid())
  localCashBoxId                      String
  type                                LocalCashMovementType
  sourceType                          LocalCashMovementSourceType
  relatedEnvelopeId                   String?
  relatedLocalExpenseId               String?
  relatedSupplierPaymentId            String?                     @unique
  relatedCostoFijoPaymentId           String?                     @unique
  relatedCreditCardStatementPaymentId String?                     @unique
  relatedCuentaCorrienteInvoiceId     String?
  relatedPosPaymentId                 String?                     @unique
  grossAmountCents                    Int?
  bankWithholdingCents                Int?                        @default(0)
  bankFeesCents                       Int?                        @default(0)
  amountCents                         Int
  date                                DateTime
  description                         String?
  createdByEmployeeId                 String
  createdAt                           DateTime                    @default(now())
  createdByEmployee                   Employee                    @relation("EmployeeLocalCashMovementsCreated", fields: [createdByEmployeeId], references: [id])
  localCashBox                        LocalCashBox                @relation(fields: [localCashBoxId], references: [id])
  relatedEnvelope                     Envelope?                   @relation(fields: [relatedEnvelopeId], references: [id])
  relatedLocalExpense                 LocalExpense?               @relation(fields: [relatedLocalExpenseId], references: [id])
  relatedSupplierPayment              SupplierPayment?            @relation(fields: [relatedSupplierPaymentId], references: [id])
  relatedCostoFijoPayment             CostoFijoPayment?           @relation(fields: [relatedCostoFijoPaymentId], references: [id])
  relatedCreditCardStatementPayment   CreditCardStatementPayment? @relation(fields: [relatedCreditCardStatementPaymentId], references: [id])
  relatedCuentaCorrienteInvoice       CuentaCorrienteInvoice?     @relation(fields: [relatedCuentaCorrienteInvoiceId], references: [id])
  relatedPosPayment                   PosPayment?                 @relation(fields: [relatedPosPaymentId], references: [id])

  @@index([localCashBoxId, date])
  @@index([type, date])
  @@index([sourceType, date])
  @@index([relatedEnvelopeId])
  @@index([relatedLocalExpenseId])
  @@index([relatedCuentaCorrienteInvoiceId])
}

model PosTable {
  id        String    @id @default(cuid())
  label     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sales     PosSale[]

  @@index([isActive, label])
}

model PosSale {
  id                       String                  @id @default(cuid())
  saleType                 PosSaleType
  status                   PosSaleStatus           @default(DRAFT)
  customerId               String?
  cuentaCorrienteAccountId String?
  cuentaCorrienteInvoiceId String?
  customerNameFreeText     String?
  tableId                  String?
  reservationAt            DateTime?
  subtotalCents            Int                     @default(0)
  totalCents               Int                     @default(0)
  externalRefs             Json?
  comandaNumber            String?
  cancellationReason       String?
  cancelledAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  cashSessionId            String?
  payments                 PosPayment[]
  cashSession              CashSession?            @relation(fields: [cashSessionId], references: [id])
  cuentaCorrienteAccount   CuentaCorrienteAccount? @relation("SaleCuentaCorriente", fields: [cuentaCorrienteAccountId], references: [id])
  cuentaCorrienteInvoice   CuentaCorrienteInvoice? @relation("InvoicedSales", fields: [cuentaCorrienteInvoiceId], references: [id])
  customer                 Customer?               @relation(fields: [customerId], references: [id])
  table                    PosTable?               @relation(fields: [tableId], references: [id])
  items                    PosSaleItem[]
  stockMovement            StockMovement?          @relation("SaleStockMovement")

  @@index([saleType, status, createdAt])
  @@index([cashSessionId, createdAt])
  @@index([customerId])
  @@index([cuentaCorrienteAccountId])
  @@index([cuentaCorrienteInvoiceId])
  @@index([tableId])
}

model PosSaleItem {
  id             String                @id @default(cuid())
  saleId         String
  productId      String
  qty            Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  product        Product               @relation(fields: [productId], references: [id])
  sale           PosSale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  modifiers      PosSaleItemModifier[]

  @@index([saleId])
  @@index([productId])
}

model PosSaleItemModifier {
  id               String         @id @default(cuid())
  saleItemId       String
  modifierOptionId String
  priceDeltaCents  Int
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  saleItem         PosSaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([modifierOptionId])
}

model PosPayment {
  id                       String                  @id @default(cuid())
  saleId                   String
  method                   PosPaymentMethod
  amountCents              Int
  cuentaCorrienteAccountId String?
  employeeId               String?
  createdAt                DateTime                @default(now())
  cuentaCorrienteAccount   CuentaCorrienteAccount? @relation(fields: [cuentaCorrienteAccountId], references: [id])
  employee                 Employee?               @relation(fields: [employeeId], references: [id])
  sale                     PosSale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reconciliationMovement   LocalCashMovement?

  @@index([saleId])
  @@index([method])
}

model StockLocation {
  id                 String              @id @default(cuid())
  code               String              @unique
  label              String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lossEvents         LossEvent[]
  productionBatches  ProductionBatch[]
  purchases          Purchase[]
  stockMovementLines StockMovementLine[]

  @@index([isActive, label])
}

model InventoryCategory {
  id        String          @id @default(cuid())
  name      String
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]

  @@index([isActive, sortOrder])
}

model InventoryItem {
  id              String                @id @default(cuid())
  categoryId      String
  name            String
  unit            StockUnit
  dimension       StockDimension        @default(COUNT)
  displayUnit     StockUnit             @default(UN)
  isActive        Boolean               @default(true)
  targetDaysCover Int                   @default(14)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  category        InventoryCategory     @relation(fields: [categoryId], references: [id])
  lossLines       LossEventLine[]
  modifierOptions ModifierOption[]
  productLinks    Product[]             @relation("ProductInventoryItem")
  productionLines ProductionBatchLine[]
  purchaseLines   PurchaseLine[]
  recipeLines     RecipeLine[]
  stockLines      StockMovementLine[]
  uoms            InventoryItemUom[]

  @@index([categoryId, isActive])
  @@index([isActive, name])
}

model InventoryItemUom {
  id                String        @id @default(cuid())
  inventoryItemId   String
  label             String
  unit              StockUnit
  multiplierToBase  Decimal       @db.Decimal(18, 6)
  isDefaultForEntry Boolean       @default(false)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, sortOrder])
  @@index([inventoryItemId, isDefaultForEntry])
}

model Recipe {
  id        String          @id @default(cuid())
  name      String
  kind      RecipeKind
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  RecipeVersion[]

  @@index([kind, isActive, name])
}

model RecipeVersion {
  id                      String            @id @default(cuid())
  recipeId                String
  version                 Int
  notes                   String?
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  productConsumptionLinks Product[]         @relation("ProductConsumptionRecipeVersion")
  productionBatches       ProductionBatch[]
  lines                   RecipeLine[]
  recipe                  Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([recipeId, isActive])
}

model RecipeLine {
  id              String                 @id @default(cuid())
  recipeVersionId String
  inventoryItemId String
  direction       StockMovementDirection
  qty             Decimal                @db.Decimal(18, 3)
  sortOrder       Int                    @default(0)
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  recipeVersion   RecipeVersion          @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)

  @@index([recipeVersionId, sortOrder])
  @@index([inventoryItemId])
}

model ProductionBatch {
  id                  String                @id @default(cuid())
  recipeVersionId     String
  locationId          String
  status              ProductionStatus      @default(DRAFT)
  occurredAt          DateTime              @default(now())
  deviationFlag       Boolean               @default(false)
  deviationReason     String?
  recommendedSnapshot Json?
  actualSnapshot      Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  location            StockLocation         @relation(fields: [locationId], references: [id])
  recipeVersion       RecipeVersion         @relation(fields: [recipeVersionId], references: [id])
  lines               ProductionBatchLine[]
  stockMovement       StockMovement?        @relation("ProductionStockMovement")

  @@index([status, occurredAt])
  @@index([locationId, occurredAt])
}

model ProductionBatchLine {
  id              String                 @id @default(cuid())
  batchId         String
  inventoryItemId String
  direction       StockMovementDirection
  qty             Decimal                @db.Decimal(18, 3)
  entryQty        Decimal?               @db.Decimal(18, 3)
  entryUnit       StockUnit?
  uomId           String?
  sortOrder       Int                    @default(0)
  batch           ProductionBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])

  @@index([batchId, sortOrder])
  @@index([inventoryItemId])
}

model Purchase {
  id                String           @id @default(cuid())
  type              PurchaseType
  status            PurchaseStatus   @default(DRAFT)
  locationId        String
  supplierId        String?
  supplierName      String?
  invoiceTotalCents Int?
  invoiceNumber     String?
  purchasedAt       DateTime         @default(now())
  postedAt          DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  location          StockLocation    @relation(fields: [locationId], references: [id])
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  lines             PurchaseLine[]
  stockMovement     StockMovement?   @relation("PurchaseStockMovement")
  payable           SupplierPayable?

  @@index([type, status, purchasedAt])
  @@index([locationId, purchasedAt])
  @@index([supplierId, purchasedAt])
}

model PurchaseLine {
  id              String        @id @default(cuid())
  purchaseId      String
  inventoryItemId String
  qty             Decimal       @db.Decimal(18, 3)
  entryQty        Decimal?      @db.Decimal(18, 3)
  entryUnit       StockUnit?
  uomId           String?
  unitCostCents   Int?
  sortOrder       Int           @default(0)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId, sortOrder])
  @@index([inventoryItemId])
}

model LossEvent {
  id            String          @id @default(cuid())
  reasonType    LossReasonType
  locationId    String
  occurredAt    DateTime        @default(now())
  notes         String?
  createdAt     DateTime        @default(now())
  location      StockLocation   @relation(fields: [locationId], references: [id])
  lines         LossEventLine[]
  stockMovement StockMovement?  @relation("LossStockMovement")

  @@index([reasonType, occurredAt])
  @@index([locationId, occurredAt])
}

model LossEventLine {
  id              String        @id @default(cuid())
  lossEventId     String
  inventoryItemId String
  qty             Decimal       @db.Decimal(18, 3)
  entryQty        Decimal?      @db.Decimal(18, 3)
  entryUnit       StockUnit?
  uomId           String?
  sortOrder       Int           @default(0)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lossEvent       LossEvent     @relation(fields: [lossEventId], references: [id], onDelete: Cascade)

  @@index([lossEventId, sortOrder])
  @@index([inventoryItemId])
}

model StockMovement {
  id                  String              @id @default(cuid())
  type                StockMovementType
  occurredAt          DateTime            @default(now())
  notes               String?
  posSaleId           String?             @unique
  purchaseId          String?             @unique
  productionBatchId   String?             @unique
  lossEventId         String?             @unique
  reversesMovementId  String?             @unique
  createdByEmployeeId String?
  createdAt           DateTime            @default(now())
  externalKey         String?             @unique
  localExpenseId      String?             @unique
  createdByEmployee   Employee?           @relation("EmployeeStockMovementsCreated", fields: [createdByEmployeeId], references: [id])
  localExpense        LocalExpense?       @relation(fields: [localExpenseId], references: [id], onDelete: Cascade)
  lossEvent           LossEvent?          @relation("LossStockMovement", fields: [lossEventId], references: [id], onDelete: Cascade)
  posSale             PosSale?            @relation("SaleStockMovement", fields: [posSaleId], references: [id], onDelete: Cascade)
  productionBatch     ProductionBatch?    @relation("ProductionStockMovement", fields: [productionBatchId], references: [id], onDelete: Cascade)
  purchase            Purchase?           @relation("PurchaseStockMovement", fields: [purchaseId], references: [id], onDelete: Cascade)
  reversesMovement    StockMovement?      @relation("StockMovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy          StockMovement?      @relation("StockMovementReversal")
  lines               StockMovementLine[]

  @@index([type, occurredAt])
}

model StockMovementLine {
  id              String                 @id @default(cuid())
  movementId      String
  inventoryItemId String
  locationId      String
  direction       StockMovementDirection
  qty             Decimal                @db.Decimal(18, 3)
  sortOrder       Int                    @default(0)
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  location        StockLocation          @relation(fields: [locationId], references: [id])
  movement        StockMovement          @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([movementId, sortOrder])
  @@index([inventoryItemId, locationId])
  @@index([locationId])
}

