enum CostoFijoCategoria {
  ALQUILER
  SALARIOS
  SERVICIOS_BASICOS
  SEGUROS
  IMPUESTOS_FIJOS
  SUSCRIPCIONES
  OTRO
}

model CostoFijo {
  id          String             @id @default(cuid())
  nombre      String
  categoria   CostoFijoCategoria
  amountCents Int
  isActive    Boolean            @default(true)
  validFrom   DateTime
  validTo     DateTime?
  notas       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payments    CostoFijoPayment[]

  @@index([isActive, validFrom])
}

// ─── Egresos y Estado de Pago a Proveedores ─────────────────────────────────

enum CashBoxKind {
  EFECTIVO
  CUENTA_BANCARIA
}

enum SupplierPayableStatus {
  PENDING
  PARTIAL
  PAID
}

enum SupplierPaymentMethod {
  EFECTIVO_CAJA
  TRANSFERENCIA
  TARJETA_CREDITO
}

model SupplierPayable {
  id               String                @id @default(cuid())
  supplierId       String
  sourcePurchaseId String?               @unique
  description      String?
  totalAmountCents Int
  paidAmountCents  Int                   @default(0)
  status           SupplierPayableStatus @default(PENDING)
  dueDate          DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  sourcePurchase   Purchase?             @relation(fields: [sourcePurchaseId], references: [id])
  payments         SupplierPayment[]

  @@index([supplierId, status])
}

model SupplierPayment {
  id                  String                @id @default(cuid())
  supplierId          String
  payableId           String?
  amountCents         Int
  date                DateTime
  method              SupplierPaymentMethod
  cashBoxId           String?
  creditCardId        String?
  installments        Int?                  @default(1)
  notes               String?
  createdByEmployeeId String
  createdAt           DateTime              @default(now())
  supplier            Supplier              @relation(fields: [supplierId], references: [id])
  payable             SupplierPayable?      @relation(fields: [payableId], references: [id])
  cashBox             LocalCashBox?         @relation(fields: [cashBoxId], references: [id])
  creditCard          CreditCard?           @relation(fields: [creditCardId], references: [id])
  createdByEmployee   Employee              @relation("EmployeeSupplierPaymentsCreated", fields: [createdByEmployeeId], references: [id])
  localCashMovement   LocalCashMovement?
  creditCardCharges   CreditCardCharge[]

  @@index([supplierId, date])
  @@index([payableId])
}

model CreditCard {
  id                String                       @id @default(cuid())
  name              String
  closingDay        Int
  dueDay            Int
  payFromCashBoxId  String?
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  payFromCashBox    LocalCashBox?                @relation(fields: [payFromCashBoxId], references: [id])
  charges           CreditCardCharge[]
  statementPayments CreditCardStatementPayment[]
  payments          SupplierPayment[]

  @@index([active, name])
}

model CreditCardCharge {
  id                String           @id @default(cuid())
  creditCardId      String
  supplierPaymentId String?
  description       String
  statementPeriod   DateTime
  installmentNumber Int
  totalInstallments Int
  amountCents       Int
  createdAt         DateTime         @default(now())
  creditCard        CreditCard       @relation(fields: [creditCardId], references: [id])
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  @@index([creditCardId, statementPeriod])
}

model CreditCardStatementPayment {
  id                  String             @id @default(cuid())
  creditCardId        String
  period              DateTime
  totalAmountCents    Int
  cashBoxId           String
  paidAt              DateTime           @default(now())
  createdByEmployeeId String
  notes               String?
  creditCard          CreditCard         @relation(fields: [creditCardId], references: [id])
  cashBox             LocalCashBox       @relation(fields: [cashBoxId], references: [id])
  createdByEmployee   Employee           @relation("EmployeeCreditCardStatementPaymentsCreated", fields: [createdByEmployeeId], references: [id])
  localCashMovement   LocalCashMovement?

  @@index([creditCardId, period])
}

model CostoFijoPayment {
  id                  String             @id @default(cuid())
  costoFijoId         String
  period              DateTime
  amountCents         Int
  cashBoxId           String
  paidAt              DateTime           @default(now())
  createdByEmployeeId String
  costoFijo           CostoFijo          @relation(fields: [costoFijoId], references: [id])
  cashBox             LocalCashBox       @relation(fields: [cashBoxId], references: [id])
  createdByEmployee   Employee           @relation("EmployeeCostoFijoPaymentsCreated", fields: [createdByEmployeeId], references: [id])
  localCashMovement   LocalCashMovement?

  @@index([costoFijoId, period])
}

model ConfigMargenCategoria {
  id                  String   @id @default(cuid())
  categoryId          String   @unique
  cogsPercent         Decimal  @db.Decimal(5, 2)
  updatedAt           DateTime @updatedAt
  updatedByEmployeeId String

  category          Category @relation(fields: [categoryId], references: [id])
  updatedByEmployee Employee @relation(fields: [updatedByEmployeeId], references: [id])

  @@index([categoryId])
}

model CcDirectCharge {
  id                       String                  @id @default(cuid())
  cuentaCorrienteAccountId String
  cuentaCorrienteAccount   CuentaCorrienteAccount  @relation(fields: [cuentaCorrienteAccountId], references: [id])
  cuentaCorrienteInvoiceId String?
  cuentaCorrienteInvoice   CuentaCorrienteInvoice? @relation(fields: [cuentaCorrienteInvoiceId], references: [id])
  date                     DateTime
  description              String
  motive                   String
  category                 CcDirectChargeCategory
  amountCents              Int
  comandaNumber            String?
  createdAt                DateTime                @default(now())
  createdByEmployeeId      String
  createdByEmployee        Employee                @relation("EmployeeCcDirectChargesCreated", fields: [createdByEmployeeId], references: [id])

  @@index([cuentaCorrienteAccountId])
  @@index([cuentaCorrienteInvoiceId])
}

model PriceBulkUpdate {
  id                  String   @id @default(cuid())
  percent             Decimal  @db.Decimal(6, 2)
  categoryIds         String[]
  affectedCount       Int
  createdAt           DateTime @default(now())
  createdByEmployeeId String

  createdByEmployee Employee       @relation("EmployeePriceBulkUpdatesCreated", fields: [createdByEmployeeId], references: [id])
  priceHistory      PriceHistory[]

  @@index([createdAt])
}

model PriceHistory {
  id                  String          @id @default(cuid())
  productId           String
  oldPriceCents       Int
  newPriceCents       Int
  changeType          PriceChangeType
  bulkUpdateId        String?
  createdAt           DateTime        @default(now())
  createdByEmployeeId String

  product           Product          @relation(fields: [productId], references: [id])
  bulkUpdate        PriceBulkUpdate? @relation(fields: [bulkUpdateId], references: [id])
  createdByEmployee Employee         @relation("EmployeePriceHistoryCreated", fields: [createdByEmployeeId], references: [id])

  @@index([productId, createdAt])
  @@index([bulkUpdateId])
}

enum PriceChangeType {
  MANUAL
  BULK
}
