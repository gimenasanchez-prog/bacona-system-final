# Copiar este archivo a .env y completar los valores reales
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Cloudflare R2 — para adjuntar facturas PDF (opcional hasta configurar la cuenta)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bacona-facturas
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Tickets de compra desde Google Drive (/compras/tickets)
# JSON completo de la cuenta de servicio de Google Cloud (en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON=
# IDs de carpeta (lo que va después de /folders/ en la URL de Drive)
DRIVE_TICKETS_FOLDER_ID=
DRIVE_PROCESSED_FOLDER_ID=
# En local poner false: así las pruebas no sacan archivos de la carpeta que usa producción
DRIVE_MOVE_PROCESSED=true
# API key de Anthropic para leer los tickets con Claude
ANTHROPIC_API_KEY=
# Clave que usa el cron de Railway para llamar a POST /api/compras/tickets/run (header Authorization: Bearer ...)
CRON_SECRET=
